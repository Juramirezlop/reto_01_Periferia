# Copia este archivo a .env y completa la clave. Nunca subas .env al repositorio.
GEMINI_API_KEY=

# Modelo principal y de respaldo (si quedan vacíos se usan estos):
LLM_MODEL=gemini-3.6-flash
LLM_MODEL_RESPALDO=gemini-3.1-flash-lite

# Topes de costo (si quedan vacíos se usan estos):
MAX_PASOS=8
MAX_TOKENS_SESION=150000

# Fecha contra la que se valida la vigencia de los soportes (AAAA-MM-DD).
# Vacía: config.ts y demo.ts usan 2026-09-03 (fecha del PRD) para que el resultado sea reproducible.
FECHA_EJECUCION=

# Puerto del servidor (opcional)
PORT=3000
