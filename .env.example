# Copia la clave de algun modelo funcional de Gemini segun la version de pago que se tenga
GEMINI_API_KEY=

# Modelo principal y de respaldo:
LLM_MODEL=gemini-3.6-flash
LLM_MODEL_RESPALDO=gemini-3.1-flash-lite

# Topes de costo:
MAX_PASOS=8
MAX_TOKENS_SESION=150000

# Fecha que valida la vigencia de los soportes, su formato es AAAA-MM-DD
# Config.ts y demo.ts usan 2026-09-03 (fecha del PRD) para que el resultado sea reproducible.
FECHA_EJECUCION=

# Puerto del servidor
PORT=3000